# MT Auto Care — static site on Apache (HawkHost cPanel)
DirectoryIndex index.html
AddType video/mp4 .mp4
AddType video/webm .webm
Options -Indexes

# Friendly 404: send unknown addresses (e.g. old WordPress links) to the home page
ErrorDocument 404 /index.html

# Cache static assets in the browser
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
