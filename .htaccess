# MT Auto Care — static site on Apache (HawkHost cPanel)
DirectoryIndex index.html
AddType video/mp4 .mp4
AddType video/webm .webm
Options -Indexes

# Friendly 404: send unknown addresses (e.g. old WordPress links) to the home page
ErrorDocument 404 /index.html

# ---- HTTPS + single hostname (https://mtautocare.com) ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  # let AutoSSL renew certificates over plain http
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://mtautocare.com%{REQUEST_URI} [R=301,L]
</IfModule>

# ---- Security ----
# Old WordPress copy and any leftover WP paths: never reachable from the web
RedirectMatch 403 ^/wordpress-cu(/.*)?$
RedirectMatch 403 ^/(wp-admin|wp-login\.php|xmlrpc\.php|wp-config\.php)
# Hidden files (except Let's Encrypt validation) and backup/config files
RedirectMatch 403 /\.(?!well-known)
<FilesMatch "\.(bak|old|orig|sql|zip|tar|gz|log|ini|sh|py|md)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # browsers remember to use https only (6 months)
  Header always set Strict-Transport-Security "max-age=15552000" "expr=%{HTTPS} == 'on'"
</IfModule>

# Cache static assets in the browser
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
